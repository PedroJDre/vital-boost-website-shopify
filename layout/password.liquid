<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Public Sans'; src: url('{{ 'public-sans.woff' | asset_url }}') format('woff'); font-weight: 100 900; font-display: swap; }
      :root { --royal: {{ settings.color_royal }}; --ink: {{ settings.color_ink }}; --mist: {{ settings.color_mist }}; --paper: {{ settings.color_paper }}; --line: {{ settings.color_ink | color_modify: 'alpha', 0.14 }}; --muted: #3F466E; --rule: #D9DCEB; --panel: #F3F4F9; --font: 'Public Sans', system-ui, sans-serif; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'formula.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
