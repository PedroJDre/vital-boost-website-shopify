<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Gloock'; src: url('{{ 'gloock.woff2' | asset_url }}') format('woff2'); font-display: swap; }
      @font-face { font-family: 'Nunito Sans'; src: url('{{ 'nunito-sans.woff2' | asset_url }}') format('woff2'); font-weight: 200 1000; font-display: swap; }
      :root { --royal: {{ settings.color_royal }}; --ink: {{ settings.color_ink }}; --mist: {{ settings.color_mist }}; --paper: {{ settings.color_paper }}; --line: {{ settings.color_ink | color_modify: 'alpha', 0.14 }}; --muted: {{ settings.color_ink | color_modify: 'alpha', 0.68 }}; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
