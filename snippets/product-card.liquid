{%- comment -%} Params: product {%- endcomment -%}
{%- liquid
  assign fi = 0
  for i in (1..3)
    assign kp = 'formula_' | append: i | append: '_product'
    assign kn = 'formula_' | append: i | append: '_name'
    assign fh = settings[kn] | handleize
    if settings[kp] != blank and settings[kp].id == product.id
      assign fi = i
    elsif settings[kp] == blank and fh != blank and product.handle contains fh
      assign fi = i
    endif
  endfor
  if fi > 0
    assign k_goal = 'formula_' | append: fi | append: '_goal'
    assign goal = settings[k_goal]
  endif
-%}
<a href="{{ product.url }}" class="card" style="{% render 'formula-style', fi: fi %}">
  <div class="card__media">
    {%- if fi > 0 -%}
      {%- render 'formula-tub', fi: fi -%}
    {%- elsif product.featured_image -%}
      {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(min-width: 750px) 33vw, 90vw' }}
    {%- endif -%}
  </div>
  <div class="card__body">
    <h3 class="card__title">{{ product.title }}</h3>
    {%- if goal != blank -%}<p class="muted">{{ goal }}</p>{%- endif -%}
    {%- render 'stars', product: product -%}
    <p class="card__price">
      Desde {{ product.price | money_without_trailing_zeros }}
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
    </p>
  </div>
</a>
