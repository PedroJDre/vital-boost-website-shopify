<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <ul class="grid-cards" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign kp = 'formula_' | append: i | append: '_product'
          assign kn = 'formula_' | append: i | append: '_name'
          assign p = settings[kp]
          if p == blank
            assign h = 'colageno-' | append: settings[kn] | handleize
            assign p = all_products[h]
          endif
        -%}
        {%- if p != blank and p.id != product.id -%}
          <li>{% render 'product-card', product: p %}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Otras fórmulas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Conocé las otras fórmulas" }
  ],
  "presets": [{ "name": "Otras fórmulas" }]
}
{% endschema %}
