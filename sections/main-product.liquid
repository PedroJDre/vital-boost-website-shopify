{%- liquid
  assign fi = 0
  for i in (1..3)
    assign kp = 'formula_' | append: i | append: '_product'
    assign kn = 'formula_' | append: i | append: '_name'
    assign fh = settings[kn] | handleize
    if settings[kp] != blank and settings[kp].id == product.id
      assign fi = i
    elsif settings[kp] == blank and fh != blank and product.handle contains fh
      assign fi = i
    endif
  endfor
  if fi > 0
    assign k_goal = 'formula_' | append: fi | append: '_goal'
    assign k_act = 'formula_' | append: fi | append: '_actives'
    assign k_pitch = 'formula_' | append: fi | append: '_pitch'
    assign k_ben = 'formula_' | append: fi | append: '_benefits'
    assign actives = settings[k_act] | replace: ' y ', ', ' | split: ', '
    assign benefits = settings[k_ben] | newline_to_br | split: '<br />'
  endif
  assign variant = product.selected_or_first_available_variant
  assign skip_first = false
  if fi > 0 and section.settings.color_first
    assign skip_first = true
  endif
-%}

<section class="pdp" style="{% render 'formula-style', fi: fi %}" data-product-section>
  <div class="wrap pdp__grid">
    <div class="gallery" data-gallery>
      <div class="gallery__track" data-gallery-track tabindex="0" aria-label="Imágenes de {{ product.title | escape }}">
        {%- if skip_first -%}
          <div class="gallery__slide gallery__slide--tub" style="background: var(--f-bg)">
            {%- render 'formula-tub', fi: fi, class: 'pdp-tub', eager: true -%}
          </div>
        {%- endif -%}
        {%- for media in product.media -%}
          {%- if skip_first and forloop.first -%}{%- continue -%}{%- endif -%}
          <div class="gallery__slide">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  assign loading = 'lazy'
                  if forloop.first and skip_first == false
                    assign loading = 'eager'
                  endif
                -%}
                {{ media | image_url: width: 1400 | image_tag: loading: loading, widths: '400,600,800,1000,1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
              {%- when 'video' -%}
                {{ media | video_tag: playsinline: true, muted: true, loop: true, controls: true, preload: 'none', image_size: '1000x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="gallery__thumbs" role="list">
        {%- assign n = 0 -%}
        {%- if skip_first -%}
          <button type="button" class="gallery__thumb" style="background: var(--f-bg)" data-thumb="0" aria-label="Ver imagen 1" aria-current="true">{% render 'formula-tub', fi: fi, small: true %}</button>
          {%- assign n = 1 -%}
        {%- endif -%}
        {%- for media in product.media -%}
          {%- if skip_first and forloop.first -%}{%- continue -%}{%- endif -%}
          <button type="button" class="gallery__thumb" data-thumb="{{ n }}" aria-label="Ver imagen {{ n | plus: 1 }}" {% if n == 0 %}aria-current="true"{% endif %}>
            {{ media.preview_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}
          </button>
          {%- assign n = n | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="pdp__info">
      {%- if fi > 0 -%}<span class="pdp__eyebrow">{{ settings[k_goal] }}</span>{%- endif -%}
      <h1 class="h1 pdp__title">{{ product.title }}</h1>
      {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- if rc > 0 -%}
        <a href="#resenas" class="pdp__rating">{% render 'stars', product: product %}</a>
      {%- endif -%}

      {%- if fi > 0 -%}
        <p class="pdp__pitch">{{ settings[k_pitch] }}</p>
        <ul class="checks" style="margin-top:16px">
          {%- for b in benefits -%}{%- assign bs = b | strip -%}{%- if bs != blank -%}<li>{{ bs }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- else -%}
        <div class="pdp__pitch rte">{{ product.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'facts' -%}
            <div class="facts" {{ block.shopify_attributes }}>
              <div><strong>{{ block.settings.f1_big }}</strong><span>{{ block.settings.f1_label }}</span></div>
              <div><strong>{{ block.settings.f2_big }}</strong><span>{{ block.settings.f2_label }}</span></div>
              <div><strong>{{ block.settings.f3_big }}</strong><span>{{ block.settings.f3_label }}</span></div>
            </div>
          {%- when 'buy' -%}
            <div class="pdp__block" data-main-buy {{ block.shopify_attributes }}>
              {%- render 'buy-form', product: product, uid: section.id -%}
            </div>
          {%- when '@app' -%}
            <div class="pdp__block">{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}

      <div class="pdp__details">
        {%- if product.description != blank -%}
          <details class="acc" open>
            <summary>Qué contiene</summary>
            <div class="acc__body rte">
              {{ product.description }}
              {%- if actives.size > 0 -%}
                <ul class="pdp__actives" role="list">
                  <li>Colágeno hidrolizado</li>
                  {%- for a in actives -%}<li>{{ a | strip }}</li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details class="acc" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="acc__body rte">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if variant.available -%}
  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="sticky-buy__info">
      <strong>{{ product.title }}</strong>
      <span data-sticky-price>{{ variant.price | money_without_trailing_zeros }}</span>
    </div>
    <button type="button" class="btn" data-sticky-go tabindex="-1">{{ settings.buy_now_label }}</button>
  </div>
{%- endif -%}

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "checkbox", "id": "color_first", "label": "Primera imagen: pote sobre el color de la fórmula", "default": true }
  ],
  "blocks": [
    { "type": "facts", "name": "Datos rápidos", "limit": 1, "settings": [
      { "type": "text", "id": "f1_big", "label": "Dato 1", "default": "9 g" },
      { "type": "text", "id": "f1_label", "label": "Detalle 1", "default": "proteína por porción" },
      { "type": "text", "id": "f2_big", "label": "Dato 2", "default": "30" },
      { "type": "text", "id": "f2_label", "label": "Detalle 2", "default": "porciones por pote" },
      { "type": "text", "id": "f3_big", "label": "Dato 3", "default": "Sin TACC" },
      { "type": "text", "id": "f3_label", "label": "Detalle 3", "default": "libre de gluten" }
    ] },
    { "type": "buy", "name": "Packs y compra", "limit": 1 },
    { "type": "accordion", "name": "Desplegable", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Modo de uso" },
      { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Disolvé 1 scoop (10 g) en 200 ml de agua, jugo, café o batido. Una vez por día.</p>" }
    ] },
    { "type": "@app" }
  ]
}
{% endschema %}
