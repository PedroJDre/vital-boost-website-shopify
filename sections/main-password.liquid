<section class="section" style="min-height:70vh;display:grid;place-items:center">
  <div class="wrap page-narrow" style="text-align:center">
    <h1 class="h1">Volvemos muy pronto</h1>
    {%- if shop.password_message != blank -%}<p class="lead" style="margin:16px auto 0">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'form-grid' -%}
      {%- if form.errors -%}<p class="notice notice--error" role="alert">Contraseña incorrecta.</p>{%- endif -%}
      <div class="field"><label for="Password">Contraseña</label><input type="password" id="Password" name="password" autocomplete="current-password"></div>
      <button type="submit" class="btn">Entrar</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Contraseña", "settings": [] }
{% endschema %}
