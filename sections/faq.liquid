<section class="section {{ section.settings.scheme }}" id="preguntas">
  <div class="wrap faq">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    {%- for block in section.blocks -%}
      <details class="acc" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="acc__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "", "options": [
      { "value": "", "label": "Blanco" }, { "value": "bg-mist", "label": "Celeste" }
    ] }
  ],
  "blocks": [
    { "type": "item", "name": "Pregunta", "settings": [
      { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Qué es el colágeno?" },
      { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
    ] }
  ],
  "presets": [{ "name": "Preguntas frecuentes", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
