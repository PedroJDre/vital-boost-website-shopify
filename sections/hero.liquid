{%- liquid
  assign total_r = 0
  assign total_c = 0
  for i in (1..3)
    assign kp = 'formula_' | append: i | append: '_product'
    assign kn = 'formula_' | append: i | append: '_name'
    assign p = settings[kp]
    if p == blank
      assign h = 'colageno-' | append: settings[kn] | handleize
      assign p = all_products[h]
    endif
    assign c = p.metafields.reviews.rating_count.value | default: 0
    if c > 0
      assign r = p.metafields.reviews.rating.value.rating | times: c
      assign total_r = total_r | plus: r
      assign total_c = total_c | plus: c
    endif
  endfor
  if total_c > 0
    assign avg = total_r | divided_by: total_c | round: 1
  endif
-%}
<section class="lab-hero">
  <div class="wrap lab-hero__grid">
    <div class="lab-hero__copy">
      <h1 class="lab-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="lab-hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="lab-hero__cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#comparar' }}" class="btn">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.show_rating and total_c > 0 -%}
          <a class="lab-hero__rating" href="#resenas">{% render 'stars', rating: avg, count: 0, bare: true %}<span>{{ avg | replace: '.', ',' }} de 5 en {{ total_c }} reseñas</span></a>
        {%- endif -%}
      </div>
      <ul class="lab-hero__proof" role="list">
        {%- if section.settings.proof_1 != blank -%}<li>{% render 'icon', name: 'truck' %}{{ section.settings.proof_1 }}</li>{%- endif -%}
        {%- if section.settings.proof_2 != blank -%}<li>{% render 'icon', name: 'shield' %}{{ section.settings.proof_2 }}</li>{%- endif -%}
        {%- if section.settings.proof_3 != blank -%}<li>{% render 'icon', name: 'flag' %}{{ section.settings.proof_3 }}</li>{%- endif -%}
      </ul>
    </div>
    <div class="lab-hero__stage">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1800', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.image.alt | default: 'Las tres fórmulas de Vital Boost', class: 'lab-hero__img' }}
      {%- else -%}
        <div class="lab-hero__tubs">
          {%- for i in (1..3) -%}
            {%- render 'formula-tub', fi: i, class: 'lab-hero__tub', eager: true -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portada",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Colágeno hidrolizado, más lo que tu objetivo necesita." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Tres fórmulas con la misma base y activos distintos. Elaboradas en Argentina, cada una con su registro RNPA." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comparar las tres" },
    { "type": "url", "id": "button_link", "label": "Link del botón", "info": "Vacío = baja a la comparación" },
    { "type": "checkbox", "id": "show_rating", "label": "Mostrar puntaje de reseñas", "default": true },
    { "type": "text", "id": "proof_1", "label": "Dato 1", "default": "Envío gratis a todo el país" },
    { "type": "text", "id": "proof_2", "label": "Dato 2", "default": "Producto registrado (RNPA)" },
    { "type": "text", "id": "proof_3", "label": "Dato 3", "default": "Hecho en Argentina" },
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Vacío = los tres potes sobre fondo gris" }
  ],
  "presets": [{ "name": "Portada" }]
}
{% endschema %}
