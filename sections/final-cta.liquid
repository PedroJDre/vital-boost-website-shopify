<section class="section final {{ section.settings.scheme }}">
  <div class="wrap">
    <h2 class="h1">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    <div class="final__formulas">
      {%- for i in (1..3) -%}
        {%- liquid
          assign kp = 'formula_' | append: i | append: '_product'
          assign kn = 'formula_' | append: i | append: '_name'
          assign p = settings[kp]
          if p == blank
            assign h = 'colageno-' | append: settings[kn] | handleize
            assign p = all_products[h]
          endif
        -%}
        {%- if p != blank -%}
          <a class="final__f" href="{{ p.url }}" style="{% render 'formula-style', fi: i %}">
            {%- render 'formula-tub', fi: i, small: true -%}
            <span>{{ settings[kn] }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Llamado final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Empezá hoy. Se nota con constancia." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "La mayoría nota cambios entre las 4 y 8 semanas de uso diario. Por eso el pack de 3 es el más elegido." },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "", "options": [
      { "value": "", "label": "Blanco" }, { "value": "bg-mist", "label": "Celeste" }
    ] }
  ],
  "presets": [{ "name": "Llamado final" }]
}
{% endschema %}
