<section class="quality2 bg-royal">
  <div class="quality2__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '600,900,1200,1500', sizes: '(min-width: 990px) 50vw, 100vw' }}
    {%- else -%}
      {%- render 'asset-img', name: 'ph-hands', small: 800, large: 1500, w: 800, h: 1200, sizes: '(min-width: 990px) 50vw, 100vw', alt: 'Manos sosteniendo Colágeno Deporte y Colágeno Belleza' -%}
    {%- endif -%}
  </div>
  <div class="quality2__body">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="lead rte quality2__text">{{ section.settings.text }}</div>{%- endif -%}
    <ul class="quality__regs" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><span>{{ block.settings.value }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Calidad y registros",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Hecho en Argentina, con todos los registros" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Desarrollamos las fórmulas junto a Foodgrade y se elaboran en un establecimiento habilitado de Bernal, Buenos Aires.</p>" },
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Vacío = la foto incluida en el tema" }
  ],
  "blocks": [
    { "type": "row", "name": "Registro", "settings": [
      { "type": "text", "id": "label", "label": "Nombre", "default": "Establecimiento elaborador" },
      { "type": "text", "id": "value", "label": "Número", "default": "RNE 02-040266" }
    ] }
  ],
  "presets": [{ "name": "Calidad y registros", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
