<section class="section {{ section.settings.scheme }}">
  <div class="wrap">
    <div class="split{% if section.settings.flip %} split--flip{% endif %}">
      <div class="split__media" style="--ar: {{ section.settings.image.aspect_ratio | default: 0.8 }}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="split__copy">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="lead rte" style="margin-top:16px">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn{% if section.settings.scheme == 'bg-royal' or section.settings.scheme == 'bg-ink' %} btn--white{% endif %}" href="{{ section.settings.button_link | default: '#formulas' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },
    { "type": "checkbox", "id": "flip", "label": "Imagen a la derecha", "default": false },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "", "options": [
      { "value": "", "label": "Blanco" }, { "value": "bg-mist", "label": "Celeste" }, { "value": "bg-royal", "label": "Azul" }, { "value": "bg-ink", "label": "Oscuro" }
    ] }
  ],
  "presets": [{ "name": "Imagen con texto" }]
}
{% endschema %}
