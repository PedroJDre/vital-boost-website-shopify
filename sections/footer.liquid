<footer class="site-footer">
  <div class="wrap">
    {%- if section.settings.show_newsletter -%}
      <div class="news">
        <div>
          <h2>{{ section.settings.news_heading }}</h2>
          {%- if section.settings.news_text != blank -%}<p>{{ section.settings.news_text }}</p>{%- endif -%}
        </div>
        {%- form 'customer', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="notice" role="status">¡Listo! Ya estás suscripto.</p>
          {%- else -%}
            <label class="visually-hidden" for="NewsEmail">Tu email</label>
            <input id="NewsEmail" type="email" name="contact[email]" placeholder="Tu email" autocomplete="email" required>
            <button type="submit" class="btn">Suscribirme</button>
            {%- if form.errors -%}<p class="notice" role="alert">Revisá el email e intentá de nuevo.</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
    <div class="footer__grid">
      <div class="footer__brand">
        <img class="footer-logo" src="{{ 'logo-white.png' | asset_url }}" width="726" height="526" alt="{{ settings.brand_name | default: shop.name | escape }}" loading="lazy">
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        <p style="display:flex;gap:8px;margin-top:18px">
          {%- if settings.social_instagram != blank -%}<a class="icon-btn" style="background:rgba(255,255,255,.1)" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a class="icon-btn" style="background:rgba(255,255,255,.1)" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        </p>
      </div>

      <div class="footer__col">
        <h2>Fórmulas</h2>
        <ul>
          {%- for i in (1..3) -%}
            {%- liquid
              assign kp = 'formula_' | append: i | append: '_product'
              assign kn = 'formula_' | append: i | append: '_name'
              assign p = settings[kp]
              if p == blank
                assign h = 'colageno-' | append: settings[kn] | handleize
                assign p = all_products[h]
              endif
            -%}
            {%- if p != blank -%}<li><a href="{{ p.url }}">Colágeno {{ settings[kn] }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer__col">
        <h2>Ayuda</h2>
        <ul>
          <li><a href="{{ routes.root_url }}#preguntas">Preguntas frecuentes</a></li>
          {%- for link in linklists[section.settings.menu_1].links -%}
            {%- unless link.url contains '/search' or link.url == routes.root_url -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endunless -%}
          {%- endfor -%}
          {%- if settings.whatsapp_number != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">WhatsApp</a></li>{%- endif -%}
        </ul>
      </div>

      <div class="footer__col">
        <h2>Legales</h2>
        <ul>
          {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
          {%- if section.settings.regret_link != blank -%}<li><a href="{{ section.settings.regret_link }}">Botón de arrepentimiento</a></li>{%- endif -%}
          <li><a href="https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario" target="_blank" rel="noopener">Defensa de las y los consumidores</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. {{ section.settings.legal }}</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="payments" role="list" aria-label="Medios de pago">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
  <a class="wa" href="https://wa.me/{{ settings.whatsapp_number }}?text={{ 'Hola! Quiero consultar por Vital Boost' | url_encode }}" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
{%- endif -%}

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar suscripción al newsletter", "default": true },
    { "type": "text", "id": "news_heading", "label": "Título del newsletter", "default": "Sumate a la comunidad" },
    { "type": "text", "id": "news_text", "label": "Texto del newsletter", "default": "Lanzamientos, recetas y beneficios para suscriptores. Sin spam." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Colágeno hidrolizado con activos para cada objetivo. Desarrollado y elaborado en Argentina." },
    { "type": "link_list", "id": "menu_1", "label": "Links extra en Ayuda", "default": "footer" },
    { "type": "url", "id": "regret_link", "label": "Link del botón de arrepentimiento", "info": "Obligatorio en Argentina (Res. 424/2020). Creá una página con el formulario y elegila acá." },
    { "type": "text", "id": "legal", "label": "Texto legal", "default": "Suplemento dietario. Consultá a tu médico antes de consumirlo." },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar botón flotante de WhatsApp", "default": false, "info": "Si usás el chat de Shopify Inbox, dejalo apagado para que no se superpongan." }
  ]
}
{% endschema %}
