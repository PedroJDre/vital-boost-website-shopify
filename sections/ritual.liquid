<section class="ed-ritual section">
  <div class="wrap">
    <div class="ed-ritual__head">
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="ed-ritual__row">
      {%- for block in section.blocks -%}
        <figure class="ed-ritual__item" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {%- render 'asset-video', name: block.settings.video, loop: true, label: block.settings.title -%}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 30vw, 72vw' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
          <figcaption>
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual (fotos con texto)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Diez segundos al día." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Un scoop al ras, en lo que ya tomás. No cambia el sabor." }
  ],
  "blocks": [
    { "type": "item", "name": "Foto", "settings": [
      { "type": "image_picker", "id": "image", "label": "Foto" },
      { "type": "text", "id": "video", "label": "Video incluido en el tema (opcional)", "info": "Nombre del video en assets, sin .mp4. Si está, reemplaza a la foto." },
      { "type": "text", "id": "title", "label": "Título", "default": "En tu café" },
      { "type": "text", "id": "text", "label": "Texto" }
    ] }
  ],
  "presets": [{ "name": "Ritual", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
