<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by 24 -%}
      <ul class="grid-cards" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- else -%}
          <li><p class="muted">No hay productos en esta colección.</p></li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Colección", "settings": [] }
{% endschema %}
