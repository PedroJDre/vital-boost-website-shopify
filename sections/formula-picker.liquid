{%- comment -%}
  The core of the home page: pick a formula, pick a pack, buy.
  The stage recolors to the selected formula.
{%- endcomment -%}
<section class="picker section" id="formulas" data-picker style="{% render 'formula-style', fi: 1 %}">
  <div class="wrap">
    <div class="section-head section-head--center">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="picker__tabs" role="tablist" aria-label="Fórmulas">
      {%- for i in (1..3) -%}
        {%- liquid
          assign kn = 'formula_' | append: i | append: '_name'
          assign kg = 'formula_' | append: i | append: '_goal'
          assign kb = 'formula_' | append: i | append: '_bg'
          assign ki = 'formula_' | append: i | append: '_ink'
        -%}
        <button type="button" role="tab" class="picker__tab" id="PickerTab-{{ section.id }}-{{ i }}" aria-controls="PickerPanel-{{ section.id }}-{{ i }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} data-tab="{{ i }}" style="--tab-bg: {{ settings[kb] }}; --tab-ink: {{ settings[ki] }}; {% render 'formula-style', fi: i %}">
          {{ settings[kn] }}<small>{{ settings[kg] }}</small>
        </button>
      {%- endfor -%}
    </div>

    {%- for i in (1..3) -%}
      {%- liquid
        assign kp = 'formula_' | append: i | append: '_product'
        assign kn = 'formula_' | append: i | append: '_name'
        assign ka = 'formula_' | append: i | append: '_actives'
        assign kt = 'formula_' | append: i | append: '_pitch'
        assign kbn = 'formula_' | append: i | append: '_benefits'
        assign ki = 'formula_' | append: i | append: '_ink'
        assign p = settings[kp]
        if p == blank
          assign h = 'colageno-' | append: settings[kn] | handleize
          assign p = all_products[h]
        endif
        assign ink_brightness = settings[ki] | color_brightness
        assign benefits = settings[kbn] | newline_to_br | split: '<br />'
      -%}
      <div class="picker__panel" role="tabpanel" id="PickerPanel-{{ section.id }}-{{ i }}" aria-labelledby="PickerTab-{{ section.id }}-{{ i }}" data-panel="{{ i }}" data-style="{% render 'formula-style', fi: i %}" {% unless forloop.first %}hidden{% endunless %}>
        <div class="stage" style="{% render 'formula-style', fi: i %}" {% if ink_brightness < 128 %}data-light-ink{% endif %}>
          <div class="stage__visual">
            <div>
              <p class="stage__name">{{ settings[kn] }}</p>
              <p class="stage__actives">Colágeno + {{ settings[ka] }}</p>
            </div>
            {%- render 'formula-tub', fi: i, class: 'stage__img' -%}
          </div>
          <div class="stage__buy">
            {%- if p != blank -%}
              <div>
                <h3 class="h3">{{ p.title }}</h3>
                <div style="margin-top:6px">{% render 'stars', product: p %}</div>
              </div>
              <p class="stage__pitch">{{ settings[kt] }}</p>
              <ul class="checks">
                {%- for b in benefits -%}{%- assign bs = b | strip -%}{%- if bs != blank -%}<li>{{ bs }}</li>{%- endif -%}{%- endfor -%}
              </ul>
              {%- assign uid = section.id | append: '-' | append: i -%}
              {%- render 'buy-form', product: p, uid: uid -%}
              <a class="stage__more link" href="{{ p.url }}">Ver ingredientes y modo de uso</a>
            {%- else -%}
              <p class="muted">Elegí el producto de esta fórmula en Configuración del tema → Fórmulas.</p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Selector de fórmulas",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Cuál es tu objetivo?" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Las tres tienen 9 g de proteína por porción. Cambia lo que suma cada una." }
  ],
  "presets": [{ "name": "Selector de fórmulas" }]
}
{% endschema %}
