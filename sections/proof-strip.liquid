<section class="section--tight {{ section.settings.scheme }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="h3" style="margin-bottom:28px">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="strip">
      {%- for block in section.blocks -%}
        <div class="strip__item" {{ block.shopify_attributes }}>
          <span class="strip__big">{{ block.settings.big }}</span>
          <span class="strip__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Datos destacados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "En todas las fórmulas" },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "", "options": [
      { "value": "", "label": "Blanco" }, { "value": "bg-mist", "label": "Celeste" }, { "value": "bg-royal", "label": "Azul" }, { "value": "bg-ink", "label": "Oscuro" }
    ] }
  ],
  "blocks": [
    { "type": "item", "name": "Dato", "settings": [
      { "type": "text", "id": "big", "label": "Número o palabra", "default": "9 g" },
      { "type": "text", "id": "label", "label": "Detalle", "default": "de proteína por porción" }
    ] }
  ],
  "presets": [{ "name": "Datos destacados", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
