{%- assign menu = linklists[section.settings.menu] -%}
<header class="site-header" data-header style="--logo-w: {{ settings.logo_width }}px">
  <div class="wrap site-header__bar">
    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }}, inicio">
        <img class="site-logo" src="{{ 'logo-ink.png' | asset_url }}" width="726" height="526" alt="{{ settings.brand_name | default: shop.name | escape }}" loading="eager">
      </a>
    </div>

    <nav class="site-header__nav" aria-label="Principal">
      <a href="{{ routes.root_url }}#comparar">Comparar fórmulas</a>
      {%- for i in (1..3) -%}
        {%- liquid
          assign kp = 'formula_' | append: i | append: '_product'
          assign kn = 'formula_' | append: i | append: '_name'
          assign p = settings[kp]
          if p == blank
            assign h = 'colageno-' | append: settings[kn] | handleize
            assign p = all_products[h]
          endif
        -%}
        {%- if p != blank -%}<a href="{{ p.url }}" {% if product and product.id == p.id %}aria-current="page"{% endif %}>{{ settings[kn] }}</a>{%- endif -%}
      {%- endfor -%}
      <a href="{{ routes.root_url }}#preguntas">Preguntas</a>
    </nav>

    <div class="site-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="text-btn site-header__account">Cuenta</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="text-btn" data-cart-open>Carrito <span class="cart-num" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span></a>
      <button type="button" class="icon-btn site-header__menu-btn" aria-label="Abrir menú" aria-controls="MenuDrawer" aria-expanded="false" data-menu-open>
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>
</header>

<div class="menu-drawer" id="MenuDrawer" data-menu-drawer>
  <div class="menu-drawer__scrim" data-menu-close></div>
  <nav class="menu-drawer__panel" aria-label="Menú" role="dialog" aria-modal="true" tabindex="-1">
    <div style="display:flex;justify-content:flex-end"><button type="button" class="icon-btn" aria-label="Cerrar menú" data-menu-close>{% render 'icon', name: 'close' %}</button></div>
    <div class="menu-drawer__formulas">
      {%- for i in (1..3) -%}
        {%- liquid
          assign kp = 'formula_' | append: i | append: '_product'
          assign kn = 'formula_' | append: i | append: '_name'
          assign kg = 'formula_' | append: i | append: '_goal'
          assign p = settings[kp]
          if p == blank
            assign h = 'colageno-' | append: settings[kn] | handleize
            assign p = all_products[h]
          endif
        -%}
        {%- if p != blank -%}
          <a class="menu-formula" href="{{ p.url }}" style="{% render 'formula-style', fi: i %}">
            {%- render 'formula-tub', fi: i, small: true -%}
            <span><strong>Colágeno {{ settings[kn] }}</strong><span>{{ settings[kg] }}</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="menu-drawer__links">
      <a href="{{ routes.root_url }}#comparar">Comparar fórmulas</a>
      <a href="{{ routes.root_url }}#como">Cómo se toma</a>
      <a href="{{ routes.root_url }}#resenas">Reseñas</a>
      <a href="{{ routes.root_url }}#preguntas">Preguntas</a>
      {%- for link in menu.links -%}
        {%- unless link.url == routes.root_url or link.url contains '/collections' or link.url contains '/search' -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endunless -%}
      {%- endfor -%}
    </div>
    {%- if shop.customer_accounts_enabled -%}
      <a class="link" href="{{ routes.account_url }}">Mi cuenta</a>
    {%- endif -%}
  </nav>
</div>

{% schema %}
{
  "name": "Encabezado",
  "class": "header-wrapper",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" }
  ]
}
{% endschema %}
