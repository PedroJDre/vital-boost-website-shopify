<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h1 class="h1">Buscar</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;margin-top:20px">
        <div class="field" style="flex:1"><label for="SearchQ" class="visually-hidden">Buscar</label><input id="SearchQ" type="search" name="q" value="{{ search.terms | escape }}" placeholder="¿Qué estás buscando?"></div>
        <button class="btn" type="submit">Buscar</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted" style="margin-bottom:20px">{{ search.results_count }} resultados para “{{ search.terms | escape }}”</p>
        <ul class="grid-cards" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a class="card" href="{{ item.url }}"><div class="card__body"><h2 class="card__title">{{ item.title }}</h2><p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p></div></a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
