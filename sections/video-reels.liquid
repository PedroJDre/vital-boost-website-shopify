<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="reels" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="reel" data-reel {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: playsinline: true, muted: true, loop: true, preload: 'none', image_size: '600x', class: 'reel__video' }}
            <button type="button" class="reel__play" aria-label="Reproducir video">{% render 'icon', name: 'play' %}</button>
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Videos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Nuestra comunidad" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "video", "id": "video", "label": "Video" },
      { "type": "image_picker", "id": "image", "label": "Imagen (si no hay video)" }
    ] }
  ],
  "presets": [{ "name": "Videos", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
