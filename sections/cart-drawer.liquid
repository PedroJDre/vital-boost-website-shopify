<div class="drawer" id="CartDrawer" data-cart-drawer data-count="{{ cart.item_count }}">
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer__head">
      <h2 class="h3" id="CartDrawerTitle">Tu carrito</h2>
      <button type="button" class="icon-btn" data-drawer-close aria-label="Cerrar carrito">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__body">
        {% render 'cart-lines' %}
      </div>
      <div class="drawer__foot">
        {%- assign savings = cart.original_total_price | minus: cart.total_price -%}
        {%- if savings > 0 -%}
          <div class="drawer__row drawer__savings"><span>Ahorrás</span><span>{{ savings | money_without_trailing_zeros }}</span></div>
        {%- endif -%}
        <div class="drawer__row"><span class="small muted">Envío</span><span class="small"><strong>Gratis</strong></span></div>
        <div class="drawer__row drawer__total"><span>Total</span><span>{{ cart.total_price | money_without_trailing_zeros }}</span></div>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--block">Finalizar compra</button>
        </form>
        <p class="buy__note"><span>{% render 'icon', name: 'shield' %}Pago seguro</span><span>{% render 'icon', name: 'truck' %}{{ settings.shipping_note }}</span></p>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="drawer__empty">
          <p class="h3">Tu carrito está vacío</p>
          <p class="muted">Elegí la fórmula que va con tu objetivo.</p>
          <div class="final__formulas">
            {%- for i in (1..3) -%}
              {%- liquid
                assign kp = 'formula_' | append: i | append: '_product'
                assign kn = 'formula_' | append: i | append: '_name'
                assign p = settings[kp]
                if p == blank
                  assign h = 'colageno-' | append: settings[kn] | handleize
                  assign p = all_products[h]
                endif
              -%}
              {%- if p != blank -%}
                <a class="final__f" href="{{ p.url }}" style="{% render 'formula-style', fi: i %}">
                  {%- render 'formula-tub', fi: i, small: true -%}
                  <span>{{ settings[kn] }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Carrito lateral",
  "settings": []
}
{% endschema %}
