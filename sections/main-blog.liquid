<section class="section">
  <div class="wrap">
    <div class="section-head"><h1 class="h1">{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 12 -%}
      <ul class="grid-cards" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a class="article-card" href="{{ article.url }}">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 750px) 33vw, 100vw' }}{%- endif -%}
              <h2 class="h3">{{ article.title }}</h2>
              <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Paginación">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
