<section class="section bg-mist">
  <div class="wrap">
    <div class="split{% if section.settings.flip %} split--flip{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="split__media split__media--crop">
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
        </div>
      {%- endif -%}
      <div class="split__copy">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
        <ol class="steps" style="margin-top:28px;grid-template-columns:1fr">
          {%- for block in section.blocks -%}
            <li class="step" {{ block.shopify_attributes }}>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p class="muted">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modo de uso",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Se toma en 10 segundos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "No tiene sabor artificial: lo mezclás con lo que ya tomás todos los días." },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "flip", "label": "Imagen a la derecha", "default": false }
  ],
  "blocks": [
    { "type": "step", "name": "Paso", "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Un scoop al ras" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Cada pote trae su medidor: 10 g por porción." }
    ] }
  ],
  "presets": [{ "name": "Modo de uso", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
