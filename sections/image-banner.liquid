<section class="ed-close">
  <div class="ed-close__media">
    {%- if section.settings.video != blank -%}
      {%- render 'asset-video', name: section.settings.video, loop: true, label: section.settings.asset_alt -%}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | default: '' }}
    {%- elsif section.settings.asset != blank -%}
      {%- render 'asset-img', name: section.settings.asset, small: 1200, large: 2400, w: 1200, h: 800, sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.asset_alt -%}
    {%- endif -%}
  </div>
  <div class="ed-close__body">
    <h2 class="ed-close__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.show_formulas -%}
      <div class="ed-banner__links">
        {%- for i in (1..3) -%}
          {%- liquid
            assign kp = 'formula_' | append: i | append: '_product'
            assign kn = 'formula_' | append: i | append: '_name'
            assign p = settings[kp]
            if p == blank
              assign h = 'colageno-' | append: settings[kn] | handleize
              assign p = all_products[h]
            endif
          -%}
          {%- if p != blank -%}
            <a class="ed-pill" href="{{ p.url }}" style="{% render 'formula-style', fi: i %}">{{ settings[kn] }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif section.settings.button_label != blank -%}
      <a class="btn btn--white" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cierre con foto o video",
  "settings": [
    { "type": "text", "id": "video", "label": "Video incluido en el tema", "info": "Nombre en assets, sin .mp4. Tiene prioridad sobre la foto.", "default": "vid-tap-trio" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "asset", "label": "Foto incluida en el tema (si no hay video ni foto)", "default": "ph-trio" },
    { "type": "text", "id": "asset_alt", "label": "Descripción", "default": "Una mano toca los potes de Vital Boost y cambia de Deporte a Belleza y Vitalidad" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elegí la tuya." },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "show_formulas", "label": "Mostrar las tres fórmulas como botones", "default": true },
    { "type": "text", "id": "button_label", "label": "Botón (si no se muestran las fórmulas)" },
    { "type": "url", "id": "button_link", "label": "Link del botón" }
  ],
  "presets": [{ "name": "Cierre con foto o video" }]
}
{% endschema %}
